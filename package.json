{
  "name": "@patimweb/pi-email",
  "version": "1.7.0",
  "description": "IMAP/SMTP email client extension for pi coding agent. Read, search, send, move, and delete emails from your inbox.",
  "keywords": [
    "pi-package",
    "email",
    "imap",
    "smtp",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-email.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-email/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "imap": "^0.8.17",
    "mailparser": "^3.7.2",
    "nodemailer": "^9.0.3",
    "typebox": "^1.2.8"
  },
  "overrides": {
    "utf7": {
      "semver": "5.7.2"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.0",
    "@types/nodemailer": "^8.0.0",
    "semantic-release": "^25.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-email/main/screenshot.png"
  }
}
